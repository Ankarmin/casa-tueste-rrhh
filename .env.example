# Copia este archivo como `.env`.
# Para Railway en una app de escritorio, usa la URL publica.
DATABASE_PUBLIC_URL=postgresql://postgres:TU_PASSWORD@TU_PROXY_DOMAIN:TU_PROXY_PORT/railway

# Opcional. Si usas DATABASE_PUBLIC_URL, la app ya activa SSL por defecto.
DB_SSL=true

# Alternativa con variables separadas.
# PGHOST=TU_PROXY_DOMAIN
# PGPORT=TU_PROXY_PORT
# PGDATABASE=railway
# PGUSER=postgres
# PGPASSWORD=TU_PASSWORD
